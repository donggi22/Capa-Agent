FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY requirements-mes.txt .
RUN pip install --no-cache-dir -r requirements-mes.txt

COPY mock_mes/ ./mock_mes/

RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8001
CMD ["uvicorn", "mock_mes.main:app", "--host", "0.0.0.0", "--port", "8001"]
